
# ── Everforest Dark ─────────────────────────────
font=JetBrainsMono Nerd Font 10

background-color=#2d353b
text-color=#d3c6aa
border-color=#a7c080
progress-color=over #a7c080

# ── Appearance ──────────────────────────────────
width=360
height=150
padding=12
margin=8
border-size=2
border-radius=8

# ── Position ────────────────────────────────────
anchor=top-right
outer-margin=10
layer=top

# ── Behavior ────────────────────────────────────
default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time
group-by=app-name

# ── Icons and text ──────────────────────────────
icons=1
max-icon-size=40
icon-location=left
markup=1
format=<b>%s</b>\n%b
text-alignment=left

# ── Mouse actions ───────────────────────────────
on-button-left=invoke-default-action
on-button-right=dismiss
on-touch=dismiss

# ── Urgent notifications ────────────────────────
[urgency=critical]
background-color=#343f44
text-color=#e67e80
border-color=#e67e80
default-timeout=0
